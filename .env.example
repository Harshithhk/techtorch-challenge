# Copy to .env and fill in. .env is git-ignored.

# LLM (required for the live agent)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
GUARD_MODEL=claude-haiku-5-5

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://rla:rla@localhost:5433/rla

# Investigation date, YYYY-MM-DD. Leave empty for today.
AS_OF_DATE=

# Assumed contract term when the plan has none (the data has no term field)
DEFAULT_TERM_MONTHS=12

# Langfuse tracing (leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
